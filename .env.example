# Public site origin for canonical URLs, Open Graph, and JSON-LD (no trailing slash).
# Example: https://www.yourdomain.com
VITE_SITE_ORIGIN=https://shhealthcentre.com

# Google Analytics 4 — optional. Format: G-XXXXXXXXXX (Admin → Data streams → Web).
# Leave unset to disable gtag on the site.
# VITE_GA_MEASUREMENT_ID=
